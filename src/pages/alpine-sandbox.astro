---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Naas from "../components/AlpineNaaS.astro";
import { faArrowUp, faPalette, faMaximize, faMinimize } from "@fortawesome/free-solid-svg-icons";

const response = await fetch("https://dummyjson.com/products/category/kitchen-accessories?limit=8&select=title,description,price,thumbnail");
const data = await response.json();
const products = data.products;

console.log('PRODUCTS')
console.log(products)

---

<Layout title="McInnes Design &#124; Alpine Sandbox">
  <div 
    class="px-6 pt-32 pb-16 lg:px-8"
    x-data="{ 
      name: $persist(''), 
      get hasName() { return this.name ? true : false }, 
      colour: $persist(''), 
      get hasColour() { return this.colour ? true : false }, 
      showPalette: false,
      showProducts: $persist(false),
      minimiseThumbnails: $persist(false),
      formattedColour: $persist(''),
      validateColour() {
        const ctx = document.createElement('canvas').getContext('2d');
        ctx.fillStyle = this.colour;
        this.formattedColour = ctx.fillStyle;
        return ctx.fillStyle;
      }
    }">
    <div class="mx-auto max-w-3xl text-base/7 text-gray-700 dark:text-gray-300">
      <p class="text-base/7 font-semibold text-indigo-600 dark:text-indigo-400">All the testing!</p>
      <h1 x-data="{ message: 'Alpine.JS Sandbox' }" x-text="message" class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl dark:text-white">
        Test
      </h1>
      <p class="mt-6 text-xl/8">
        Somewhere to mess around with the Alpine JS Framework. Want to try out Alpine.JS for yourself, check out their documentation and setup guide <a href="https://alpinejs.dev/" target="_blank" class="group text-indigo-600 dark:text-indigo-300 border-b-2 sm:border-transparent sm:mb-1 sm:hover:border-current sm:hover:pb-1 sm:hover:mb-0 sm:duration-200 sm:ease-in-out">here<Icon icon={faArrowUp} class="align-super! ml-auto rotate-45 size-3! group-hover:animate-bounce" /></a>
      </p>

      <div class="mt-6 mx-auto max-w-xl bg-white shadow-sm rounded-lg dark:bg-gray-800/50 dark:shadow-none dark:outline dark:-outline-offset-1 dark:outline-white/10">
        <div class="px-4 py-5 sm:p-6">
          <h3 class="text-base font-semibold text-gray-900 dark:text-white">Enter your name to begin</h3>
          <div class="mt-2 max-w-xl text-sm text-gray-500 dark:text-gray-400">
            <p>Don&apos;t worry, your data won&apos;t be stored anywhere or sold for advertising</p>
          </div>
          <form @submit.prevent class="mt-5 flex sm:items-center">
            <div class="w-full">
              <input
                x-model.debounce="name"
                type="text"
                name="name"
                id="name"
                autocomplete="name"
                placeholder="Joe Citizen"
                aria-label="Name"
                class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-400 dark:focus:outline-indigo-500"
              />
            </div>
            <button
              x-cloak
              x-show="hasName"
              @click="name = ''"
              class="inline-flex items-center justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 mt-0 ml-3 w-auto dark:bg-indigo-500 dark:shadow-none dark:hover:bg-indigo-400 dark:focus-visible:outline-indigo-500"
            >
              Clear
            </button>
          </form>
          <p x-cloak x-show="hasName" class="mt-6 max-w-xl text-xs text-green-500 dark:text-green-400">
            Psst, hey you can keep editing this field if you want to change your name
          </p>
        </div>
      </div>

      <p x-cloak x-show="hasName" class="mt-6 mx-auto max-w-xl text-xl/8">
        Hi <span x-text="name"></span>!
      </p>

      <div x-cloak x-show="hasName" class="mt-6 mx-auto max-w-xl bg-white shadow-sm rounded-lg dark:bg-gray-800/50 dark:shadow-none dark:outline dark:-outline-offset-1 dark:outline-white/10">
        <div class="px-4 py-5 sm:p-6">
          <h3 class="text-base font-semibold text-gray-900 dark:text-white">What about your favourite colour?</h3>
          <div class="mt-2 max-w-xl text-sm text-gray-500 dark:text-gray-400">
            <p>I won&apos;t judge</p>
          </div>
          <form @submit.prevent class="mt-5 flex sm:items-center">
            <div class="w-full">
              <input
                x-model.debounce="colour"
                x-effect="validateColour"
                type="text"
                name="colour"
                id="colour"
                placeholder="Chartreuse"
                aria-label="Colour"
                class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-400 dark:focus:outline-indigo-500"
              />
            </div>
            <button
              @click="showPalette = ! showPalette"
              class="inline-flex items-center justify-center rounded-md bg-indigo-600 p-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 mt-0 ml-3 w-auto dark:bg-indigo-500 dark:shadow-none dark:hover:bg-indigo-400 dark:focus-visible:outline-indigo-500"
            >
              <Icon icon={faPalette} class="size-auto text-xl" />
            </button>
            <button
              x-show="hasColour"
              @click="colour = ''"
              class="inline-flex items-center justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 mt-0 ml-3 w-auto dark:bg-indigo-500 dark:shadow-none dark:hover:bg-indigo-400 dark:focus-visible:outline-indigo-500"
            >
              Clear
            </button>
          </form>
          
          <p x-show="hasColour" class="mt-6 max-w-xl text-xs text-green-500 dark:text-green-400">
            Not seeing the colour you thought? You can use any of the following:
          </p>

          <ul x-show="hasColour" class="ml-4 max-w-xl text-xs/5 text-green-500 dark:text-green-400 text-pretty">
            <li class="my-1">
              <a 
                href="https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/named-color#value" 
                target="_blank" 
                class="group text-green-800 dark:text-green-600 border-b-2 border-current sm:border-transparent sm:hover:border-current"
              >
                Named Colours<Icon icon={faArrowUp} class="align-super! ml-auto rotate-45 size-3! group-hover:animate-bounce" />
              </a> 
              &nbsp;remove any spaces for two word colours, e.g: "lightyellow"
            </li>
            <li class="my-1">
              <a 
                href="https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Colors" 
                target="_blank" 
                class="group text-green-800 dark:text-green-600 border-b-2 border-current sm:border-transparent sm:hover:border-current"
              >
                Supported CSS Colours<Icon icon={faArrowUp} class="align-super! ml-auto rotate-45 size-3! group-hover:animate-bounce" />
              </a> 
              &nbsp;e.g. RGB, HEX, HSL, HWB
            </li>
            <li class="my-1">
              <a 
                href="https://tailwindcss.com/docs/colors" 
                target="_blank" 
                class="group text-green-800 dark:text-green-600 border-b-2 border-current sm:border-transparent sm:hover:border-current"
              >
                Supported Tailwind CSS Colours<Icon icon={faArrowUp} class="align-super! ml-auto rotate-45 size-3! group-hover:animate-bounce" />
              </a> 
              &nbsp;use the colour palette above to select these
            </li>
          </ul>
          
          <ul
            x-show="showPalette"
            x-data="{
              paletteColours: ['red', 'orange', 'amber', 'yellow', 'lime', 'green', 'emerald', 'cyan', 'sky', 'blue', 'indigo', 'violet', 'purple', 'fuchsia', 'pink', 'rose', 'slate', 'gray', 'zinc', 'neutral', 'stone'],
              paletteSteps: [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950]
            }"
            role="list"
            class="mx-auto mt-6 grid max-w-md grid-cols-11 gap-1 sm:gap-2 text-center"
          >
            <template x-for="paletteColour in paletteColours.reverse()">
              <template x-for="paletteStep in paletteSteps">
                <button
                  @click="showPalette = ! showPalette, colour = `--color-${paletteColour}-${paletteStep}`"
                  class="mx-auto size-7 sm:size-8 rounded-full outline-1 -outline-offset-1 outline-black/5 dark:outline-white/10"
                  :class="`bg-${paletteColour}-${paletteStep}`"
                />                
              </template>
            </template>
          </ul>

          <div x-show="showPalette" class="flex mx-auto mt-6 gap-x-4 sm:col-span-2">
            <label for="colour" class="text-sm/6 text-gray-600 dark:text-gray-400">
              Or pick a RGB, HEX, or HSL:
            </label>
              <div class="flex h-6 items-center">
                <input
                  x-model.debounce="colour" 
                  :value="formattedColour"
                  id="palette-colour-picker"
                  name="palette-colour-picker"
                  type="color"
                  aria-label="Select a colour"
                  class=""
                />
            </div>
          </div>

        </div>
      </div>

      <div 
        x-cloak
        x-show="hasColour" 
        class="mt-6 mx-auto max-w-xl bg-(--alpine-colour) shadow-sm rounded-lg dark:shadow-none dark:outline dark:-outline-offset-1 dark:outline-white/10" 
        :style="{ '--alpine-colour': colour.startsWith('--color-') ? `var(${colour})` : formattedColour }"
      >
        <div :class="formattedColour === '#000000' & !colour.startsWith('--color-') ? 'px-4 py-5 sm:p-6 rounded-lg outline-0 text-white' : 'px-4 py-5 sm:p-6 rounded-lg outline-0 text-(--alpine-colour) invert'">
          <h3 class="text-lg/8 font-semibold text-balance">Great choice! Looks like you went with a shade of &apos;<span x-text="colour.startsWith('--color-') ? colour.slice(8).replace(/-.*$/,'') : colour"></span>&apos;</h3>
          <div class="mt-2 max-w-xl text-sm">
            <p class="mt-2">Here is some random text so you can really take the time to appreciate your new look.</p>
            <p class="mt-2">Did you know a &quot;punch&quot; from a Mantis Shrimp&apos;s claw delivers 1,500 Newtons of force in under three-thousandths of a second.</p>
            <p class="mt-2">Which is quick enough to boil the water around them and produce an underwater shockwave in their wake&ast;</p>
            <p class="mt-6">Ran out of ideas for colours, did you check out the palette selector?</p>
            <p class="mt-2 group text-xs">
              <a 
                href="https://theoatmeal.com/comics/mantis_shrimp" 
                target="_blank" 
                class="border-b-2 border-current sm:border-transparent sm:hover:border-current"
              >
                <span class="align-super">&ast;</span>References<Icon icon={faArrowUp} class="align-super! ml-auto rotate-45 size-3! group-hover:animate-bounce" />
              </a> 
            </p>
          </div>
        </div>
      </div>

      <p x-cloak x-show="hasColour" class="mt-6 mx-auto max-w-xl text-xl/8">
        Ok, now lets see how Alpine can be used to poll for and dynamically update data
      </p>

      <div x-cloak x-show="hasColour" class="mt-6 mx-auto max-w-xl bg-white shadow-sm rounded-lg dark:bg-gray-800/50 dark:shadow-none dark:outline dark:-outline-offset-1 dark:outline-white/10">
        <div class="px-4 py-5 sm:p-6">
          <h3 class="text-base font-semibold text-gray-900 dark:text-white">Press the button below for an API response</h3>
          <div class="mt-2 max-w-xl text-sm text-balance text-gray-500 dark:text-gray-400">
            <p>
              This component intentionally returns a negative response from the&nbsp;
              <a 
                href="https://github.com/hotheadhacker/no-as-a-service" 
                target="_blank" 
                class="border-b-2 border-current sm:border-transparent sm:hover:border-current"
              >
                no-as-a-service<Icon icon={faArrowUp} class="align-super! ml-auto rotate-45 size-3! group-hover:animate-bounce" />
              </a> 
              &nbsp;API
            </p>
          </div>
          <Naas>
            <p slot="message" class="text-xs text-red-500 dark:text-red-400">
              Hey <span x-text="name || 'Mate'"></span>, this is actually an error and not an expected response from the API
            </p>
          </Naas>
        </div>
      </div>
    </div>

    <div class="text-gray-700 dark:text-gray-300">

      <p
        x-cloak 
        x-show="$store.usedNaaS" 
        class="mx-auto max-w-2xl px-4 pt-12 sm:px-6 lg:max-w-7xl lg:px-8 text-xl/8"
      >
        Great work <span x-text="name"></span>, let&apos;s keep going...
        <button
          x-show="!showProducts"
          @click="showProducts = true"
          type="button"
          class="relative inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:bg-indigo-500 dark:shadow-none dark:hover:bg-indigo-400 dark:focus-visible:outline-indigo-500"
        >
          OK!
        </button>
      </p>

      <div
        x-cloak 
        x-show="showProducts" 
        class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24 lg:max-w-7xl lg:px-8"
      >

      <div class="-mt-2 -ml-4 flex flex-wrap items-center justify-between sm:flex-nowrap">
        <div class="mt-2 ml-4">
          <h3 class="text-xl/8 text-gray-900 dark:text-white">Products</h3>
          <p class="text-balance">Mess around with the &apos;Thumbnails&apos; button to see how Alpine can dynamically switch up our grid layout</p>
        </div>
        <div class="mt-2 ml-4 shrink-0">
          <button
            x-show="!minimiseThumbnails" 
            @click="minimiseThumbnails = ! minimiseThumbnails"
            type="button"
            class="relative inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:bg-indigo-500 dark:shadow-none dark:hover:bg-indigo-400 dark:focus-visible:outline-indigo-500"
          >
            Thumbnails
            &nbsp;
            <Icon icon={faMinimize} class="!size-5" />
          </button>
          <button
            x-show="minimiseThumbnails" 
            @click="minimiseThumbnails = ! minimiseThumbnails"
            type="button"
            class="relative inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:bg-indigo-500 dark:shadow-none dark:hover:bg-indigo-400 dark:focus-visible:outline-indigo-500"
          >
            Thumbnails
            &nbsp;
            <Icon icon={faMaximize} class="!size-5" />
          </button>
        </div>
      </div>
        

        <div 
          class="mt-6 grid gap-x-6 gap-y-10 xl:gap-x-8"
          :class="minimiseThumbnails ? 'grid-cols-1 lg:grid-cols-2 xl:grid-cols-3' : 'grid-cols-2 lg:grid-cols-3 xl:grid-cols-4'"
        >
          {products.map((product: { description: string; thumbnail: string; title: string; price: number; }) => (
            <div class="group">
              <img
                alt={product.description}
                src={product.thumbnail}
                class="aspect-square w-full rounded-lg bg-gray-200 object-cover group-hover:opacity-75 xl:aspect-7/8"
              />
              <h3 class="mt-4 text-sm text-gray-700 dark:text-gray-300">{product.title}</h3>
              <p class="mt-1 text-lg font-medium text-gray-900 dark:text-white">{product.price}</p>
            </div>
          ))}
        </div>
        <p class="mt-8 text-xs">
          Product data provided via&nbsp;
          <a 
            href="https://dummyjson.com/" 
            target="_blank" 
            class="border-b-2 border-current sm:border-transparent sm:hover:border-current"
          >
            DummyJSON<Icon icon={faArrowUp} class="align-super! ml-auto rotate-45 size-3! group-hover:animate-bounce" />
          </a> 
          &nbsp;API
        </p>
      </div>

      <div 
        x-cloak
        x-show="hasColour && showProducts" 
        class="mt-2 mx-auto max-w-xl bg-(--alpine-colour) shadow-sm rounded-lg dark:shadow-none dark:outline dark:-outline-offset-1 dark:outline-white/10" 
        :style="{ '--alpine-colour': colour.startsWith('--color-') ? `var(${colour})` : formattedColour }"
      >
        <div class="px-4 py-5 sm:p-6 rounded-lg outline-0" :class="formattedColour === '#000000' & !colour.startsWith('--color-') ? 'text-white' :'text-(--alpine-colour) invert'">
          <h3 class="text-xl/8 font-semibold text-balance">Congrats <span x-text="name"></span>!</h3>
          <div class="mt-2 max-w-xl text-sm">
            <p class="mt-2">That's about everything I've coded so far</p>
          </div>
        </div>
      </div>

      <p class="dark:text-gray-50 text-center mt-12">Check out some of our other <a href={`/projects`} class="text-indigo-600 dark:text-indigo-300 border-b-2 sm:border-transparent sm:mb-1 sm:hover:border-current sm:hover:pb-1 sm:hover:mb-0 sm:duration-200 sm:ease-in-out">Projects</a></p>


    </div>
  </div>
</Layout>

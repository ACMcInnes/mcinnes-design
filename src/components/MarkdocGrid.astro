---
const { heading, description } = Astro.props;
---

<div class="py-4 sm:py-8">
  <div class="mx-auto max-w-7xl">
    <h2>{heading}</h2>
    <p>{description}</p>
    <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-20 md:mx-0 md:max-w-none md:grid-cols-2 lg:grid-cols-3">
      <slot />
    </div>
  </div>
</div>
